---
import type { Testimonial } from '../../data/testimonials';

interface Props { testimonial: Testimonial; index: number }
const { testimonial, index } = Astro.props;
const isStudent = testimonial.category === 'student';
const preview = isStudent ? testimonial.quote : testimonial.quote.split('\n\n')[0];
const hasMore = preview !== testimonial.quote;
---
<article class:list={['testimonial-card', { 'testimonial-card-student': isStudent }]} data-testimonial-id={testimonial.id}>
  <div class="testimonial-card-top"><span class="mono">{String(index).padStart(2, '0')} / {isStudent ? 'STUDENT RESPONSE' : 'LINKEDIN RECOMMENDATION'}</span><span class="testimonial-mark" aria-hidden="true">“</span></div>
  <blockquote class="testimonial-preview" lang={testimonial.language} dir="ltr">{preview}</blockquote>
  {hasMore && <details class="testimonial-full"><summary>Read full recommendation <span aria-hidden="true">↗</span></summary><blockquote lang={testimonial.language} dir="ltr">{testimonial.quote}</blockquote></details>}
  <div class="testimonial-attribution">
    <div><p class="testimonial-author" lang="en">{testimonial.displayName}</p><p class="testimonial-role">{testimonial.role}</p></div>
    {testimonial.linkedInUrl && <a href={testimonial.linkedInUrl} target="_blank" rel="noopener noreferrer" aria-label={`View ${testimonial.displayName}'s LinkedIn profile (opens in new tab)`}>Profile ↗</a>}
  </div>
</article>
