---
import { copy } from '../../data/copy';
import { profile } from '../../data/profile';
---
<footer class="site-footer">
  <div class="shell footer-inner">
    <p>{copy.footer}</p>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} {profile.displayName}</span><div><a href={profile.links.github} target="_blank" rel="noopener noreferrer">GitHub <span class="sr-only">(opens in new tab)</span></a><a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span class="sr-only">(opens in new tab)</span></a></div><a href="/#home">Back to top ↑</a></div>
  </div>
</footer>
