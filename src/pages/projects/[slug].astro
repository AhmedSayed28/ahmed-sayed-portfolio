---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/siteConfig';
import BusinessSpecimen from '../../components/projects/BusinessSpecimen.astro';

export async function getStaticPaths() {
  if (!siteConfig.sections.work) return [];
  const projects = await getCollection('projects', ({ data }) => data.visible && data.status === 'published');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title={`${project.data.title} — Ahmed Sayed`} description={project.data.description}>
  <article class="project-detail shell"><a class="back-link" href={`${base}#work`}>← Back to work</a><div class="detail-heading"><span class="eyebrow">CASE FILE / {project.data.category.toUpperCase()}</span><h1>{project.data.title}</h1><p>{project.data.description}</p><div class="detail-actions"><a class="button button-primary" href={project.data.githubUrl} target="_blank" rel="noopener noreferrer">Inspect the source ↗ <span class="sr-only">(opens in new tab)</span></a>{project.data.demoUrl && <a class="button button-text" href={project.data.demoUrl} target="_blank" rel="noopener noreferrer">Live demo ↗ <span class="sr-only">(opens in new tab)</span></a>}</div></div><div class="detail-grid"><div class="detail-main"><div class="detail-body"><Content /></div><section><span class="eyebrow">ENGINEERING DECISIONS</span><ul class="decision-list">{project.data.decisions.map((decision: string) => <li>{decision}</li>)}</ul></section><section><span class="eyebrow">THE EDGE CASE</span><p>{project.data.edgeCase}</p></section></div><aside class="detail-aside">{project.data.specimen && <BusinessSpecimen kind={project.data.specimen} />}<div class="detail-meta"><strong>Project record</strong><p>{project.data.category}</p><ul class="tag-list" aria-label="Technologies">{project.data.technologies.map((tech: string) => <li>{tech}</li>)}</ul></div></aside></div></article>
</BaseLayout>
